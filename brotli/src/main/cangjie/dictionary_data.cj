    private static let SIZE_BITS_DATA = "AAAAKKLLKKKKKJJIHHIHHGGFF"

    private static func unpackDictionaryData(dictionary: ByteBuffer, data0: String, data1: String, skipFlip: String, sizeBits: Array<Int32>, sizeBitsData: String): Unit {
        let dict = Utils.toUsAsciiBytes(data0 + (data1))
        if (Int64(dict.size) != dictionary.capacity) {
            throw Exception("Corrupted brotli dictionary")
        }
        var offset = 0
        let n = Int32(skipFlip.size) >> 1
        for (i in 0..n) {
            let skip = Int32(((skipFlip[Int64(2 * i)]))) - 36
            let flip = Int32(((skipFlip[Int64(2 * i + 1)]))) - 36
            for (j in 0..skip) {
                dict[offset] = UInt8(Int32((dict[offset])) ^ 3)
                offset++
            }
            for (j in 0..flip) {
                dict[offset] = UInt8(Int32((dict[offset])) ^ 236)
                offset++
            }
        }
        for (i in 0..Int32(sizeBitsData.size)) {
            sizeBits[Int64(i)] = Int32(((sizeBitsData[Int64(i)]))) - 65
        }
        dictionary.write(dict)
    }

