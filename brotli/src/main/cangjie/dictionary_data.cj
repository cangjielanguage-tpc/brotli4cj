        if (Int64(data.size) != dictionary.capacity) {
            throw Exception("Corrupted brotli dictionary")
        }
        var offset = 0
        let n = Int32(skipFlip.size) >> 1
        for (i in 0..n) {
            let skip = Int32(skipFlip[Int64(2 * i)]) - 36
            let flip = Int32(skipFlip[Int64(2 * i + 1)]) - 36
            for (j in 0..skip) {
                data[offset] = UInt8(Int32((data[offset])) ^ 3)
                offset++
            }
            for (j in 0..flip) {
                data[offset] = UInt8(Int32((data[offset])) ^ 236)
                offset++
            }
        }
        for (i in 0..Int32(sizeBitsData.size)) {
            sizeBits[Int64(i)] = Int32(sizeBitsData.get(Int64(i)).getOrThrow()) - 65
        }
        dictionary.write(data)
    }

    static init() {
        var dictionaryData: ByteBuffer = ByteBuffer(122784)
        let dictionarySizeBits = Array<Int32>(25) { _ => 0 }
        unpackDictionaryData(dictionaryData, DATA, SKIP_FLIP, dictionarySizeBits, SIZE_BITS_DATA)
        Dictionary.setData(dictionaryData, dictionarySizeBits)
    }
}
